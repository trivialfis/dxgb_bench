ARG PIXI_VERSION=0.77.0
FROM ghcr.io/prefix-dev/pixi:${PIXI_VERSION} AS pixi
FROM nvcr.io/nvidia/cuda:13.2.1-base-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY --from=pixi /usr/local/bin/pixi /usr/local/bin/pixi

RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install --no-install-recommends -y \
        ca-certificates curl git gosu numactl perl time wget && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /ws
COPY dev/install_nsys.sh dev/install_ncu.sh /ws/
ARG ARCH
RUN apt-get update && \
    ./install_nsys.sh "${ARCH}" && \
    ./install_ncu.sh "${ARCH}" && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /ws/dxgb_bench
COPY . .

# Docker builds cannot detect the host GPU.
RUN --mount=type=cache,target=/root/.cache/rattler \
    CONDA_OVERRIDE_CUDA=13.2 pixi install --environment dev && \
    CONDA_OVERRIDE_CUDA=13.2 pixi shell-hook --as-is --environment dev --shell bash \
        > /etc/profile.d/pixi.sh

# Keep XGBoost arguments below the benchmark build to preserve its cache.
ARG SM
RUN source /etc/profile.d/pixi.sh && bash dev/build_dxgb_bench.sh "${SM}"

ARG INSTALL_XGBOOST
ARG XGBOOST_REPO
ARG XGBOOST_CHECKOUT
RUN source /etc/profile.d/pixi.sh && \
    bash dev/clone_xgboost.sh "${INSTALL_XGBOOST}" "${XGBOOST_REPO}" "${XGBOOST_CHECKOUT}" && \
    bash dev/install_xgboost.sh "${INSTALL_XGBOOST}" "${SM}"

COPY --chmod=755 dev/entrypoint.sh /usr/local/bin/dxgb-entrypoint
ENV PATH="/ws/dxgb_bench/.pixi/envs/dev/bin:${PATH}"
ENTRYPOINT ["/usr/local/bin/dxgb-entrypoint"]
CMD ["/bin/bash"]
